# Copy to .env and fill in. `.env` is gitignored.

# --- Database -------------------------------------------------------------
# ProgFrog targets Neon; this default matches the docker-compose Postgres
# service for a purely-local setup. Swap for your Neon connection string.
DATABASE_URL="postgresql://progfrog:progfrog@localhost:5432/progfrog"

# --- Auth.js -------------------------------------------------------------
# Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Absolute origin of the app — used to build links in verification / reset
# emails. Defaults to http://localhost:3001; set it to the deployed URL in prod.
APP_URL="http://localhost:3001"

# --- OAuth providers (all optional) -------------------------------------
# Email + password sign-up works without any of these. Each provider only
# appears / works once its ID + SECRET pair is set.
#
# For EACH provider, register BOTH callback URLs on its console (they take a
# list — you don't choose one):
#     http://localhost:3001/api/auth/callback/<provider>          (dev)
#     https://progfrog.vercel.app/api/auth/callback/<provider>    (prod)
# and both origins where asked: http://localhost:3001 and https://progfrog.vercel.app
# A `redirect_uri_mismatch` error = that URL isn't registered.

# Google — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook — https://developers.facebook.com/apps  (the `email` permission needs
# Meta App Review before it works for non-testers)
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# X / Twitter — https://developer.x.com  (OAuth 2.0; X does NOT return an email,
# so those accounts have no address on file)
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# In production (e.g. Vercel) also set AUTH_URL to the deployed origin, so
# Auth.js builds OAuth callback URLs against the right host:
#   AUTH_URL="https://progfrog.vercel.app"

# --- Email (verification + password reset) -----------------------------
# https://resend.com/api-keys
# Optional. When the key is unset — or Resend rejects a send — the link is
# written to the server log ([email:link] ...) so it's still recoverable.
RESEND_API_KEY=""
# EMAIL_FROM defaults to "ProgFrog <onboarding@resend.dev>", which only DELIVERS
# to your own Resend-account address. To email anyone else, verify a domain you
# own in Resend and set EMAIL_FROM to an address on it, e.g.:
#   EMAIL_FROM="ProgFrog <noreply@yourdomain.com>"
# EMAIL_FROM=""

# --- Training assistant (chatbot) --------------------------------------
# Anthropic API key: https://console.anthropic.com/settings/keys
# Optional — the in-app coach is disabled (503) when this is unset.
ANTHROPIC_API_KEY=""
