// Prisma schema — https://pris.ly/d/prisma-schema
// Prisma 7 uses the `prisma-client` generator (ESM) and a driver adapter.
// The connection URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models — https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  name          String?
  /// Nullable: X / Twitter sign-in never returns an email address.
  email         String?    @unique
  emailVerified DateTime?
  /// bcrypt hash — only set for accounts that signed up with email + password.
  passwordHash  String?
  image         String?
  weightUnit    WeightUnit @default(KG)
  heightCm      Float?
  birthday      DateTime?
  /// When the user agreed to let the training assistant read their logged data.
  chatConsentAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts    Account[]
  sessions    Session[]
  authTokens  AuthToken[]
  exercises   Exercise[]
  workouts    Workout[]
  templates   Template[]
  bodyEntries BodyEntry[]
}

/// Short-lived single-use token for the email-verification and password-reset
/// flows. Only the SHA-256 hash of the token is stored; the raw value goes out
/// in the email link and is never persisted.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expires   DateTime
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// A dated body-weight measurement, so the user can track body progress
/// alongside their lifts. `weightKg` is always stored in kilograms.
model BodyEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  weightKg  Float
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Workout tracking
// ---------------------------------------------------------------------------

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  OTHER
}

enum WeightUnit {
  KG
  LB
}

/// The kind of a single set — planned (in a template) or logged (in a workout).
/// `NORMAL` is a straight working set; `WARMUP` is excluded from volume/PR math;
/// `DROP` continues the previous set at a lighter load with no rest; `FAILURE`
/// is taken to muscular failure.
enum SetType {
  WARMUP
  NORMAL
  DROP
  FAILURE
}

/// How an exercise connects to the next one in the same session.
/// `SUPERSET`: alternate between the two with no rest, then rest once at the end.
/// `DROP_SET`: go straight into the next (usually lighter) exercise with no rest.
enum ExerciseLink {
  SUPERSET
  DROP_SET
}

/// Exercise catalog. `ownerId == null` is a global seeded exercise visible to
/// everyone; a set `ownerId` is a private custom exercise for that one user.
model Exercise {
  id         String        @id @default(cuid())
  /// Idempotency key from the offline outbox — lets a replayed create no-op.
  clientId   String?       @unique
  name       String
  equipment  Equipment     @default(BARBELL)
  muscle     String?
  isTimed    Boolean       @default(false)
  ownerId    String?
  owner      User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isArchived Boolean       @default(false)
  createdAt  DateTime      @default(now())

  workoutExercises  WorkoutExercise[]
  templateExercises TemplateExercise[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Workout {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime     @default(now())
  name          String?
  notes         String?
  unit          WeightUnit   @default(KG)
  /// When the session actually began / ended in the gym. Editable by the user;
  /// `startedAt` defaults to creation time, `endedAt` is stamped on finish.
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  finishedAt    DateTime?
  templateDayId String?
  templateDay   TemplateDay? @relation(fields: [templateDayId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  exercises WorkoutExercise[]

  @@index([userId, date])
}

/// One entry in a workout. It is a "slot": it always carries a `muscle` snapshot,
/// and optionally names the specific `exercise` that filled it.
model WorkoutExercise {
  id            String        @id @default(cuid())
  /// Idempotency key from the offline outbox — lets a replayed create no-op.
  clientId      String?       @unique
  workoutId     String
  workout       Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId    String?
  exercise      Exercise?     @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  muscle        String?
  targetSets    Int?
  targetReps    String?
  order         Int           @default(0)
  equipment     Equipment?
  linkToNext    ExerciseLink?
  notes         String?

  sets SetEntry[]

  @@index([workoutId])
}

model SetEntry {
  id                String          @id @default(cuid())
  /// Idempotency key from the offline outbox — lets a replayed create no-op.
  clientId          String?         @unique
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  order             Int             @default(0)
  type              SetType         @default(NORMAL)
  /// Rep target for this set, snapshotted from the template ("8-12", "AMRAP").
  targetReps        String?
  reps              Int             @default(0)
  seconds           Int?
  weight            Float           @default(0)
  rpe               Float?

  @@index([workoutExerciseId])
}

model Template {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days TemplateDay[]

  @@index([userId])
}

model TemplateDay {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)

  exercises TemplateExercise[]
  workouts  Workout[]

  @@index([templateId])
}

/// A planned slot in a template day: a `muscle` to hit, optionally with a default
/// `exercise` pencilled in. Its `sets` spell out the planned set list.
model TemplateExercise {
  id            String        @id @default(cuid())
  templateDayId String
  templateDay   TemplateDay   @relation(fields: [templateDayId], references: [id], onDelete: Cascade)
  exerciseId    String?
  exercise      Exercise?     @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  muscle        String?
  order         Int           @default(0)
  /// Default rep target for every set that doesn't override it ("8-12").
  targetReps    String?
  linkToNext    ExerciseLink?

  sets TemplateSet[]

  @@index([templateDayId])
}

/// One planned set within a template slot.
model TemplateSet {
  id                 String           @id @default(cuid())
  templateExerciseId String
  templateExercise   TemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)
  order              Int              @default(0)
  type               SetType          @default(NORMAL)
  /// Per-set rep target; falls back to the slot's `targetReps` when null.
  targetReps         String?

  @@index([templateExerciseId])
}
